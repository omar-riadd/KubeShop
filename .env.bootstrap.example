# Copy to .env.bootstrap (git-ignored) and fill in your deployment values.
# Then run: make bootstrap

# GitHub organization or username owning the repository (<GH_OWNER>)
GH_OWNER=your-github-username

# Optional: GitHub repository name (defaults to kubeshop-platform)
# GH_REPO=KubeShop

# Route 53 hosted zone base domain (<BASE_DOMAIN>, e.g. example.com or lab.internal)
BASE_DOMAIN=example.com

# 12-digit AWS account ID (<AWS_ACCOUNT_ID>)
AWS_ACCOUNT_ID=123456789012

# AWS region (<AWS_REGION>)
AWS_REGION=eu-central-1

# Amazon EKS cluster name (<CLUSTER_NAME>)
CLUSTER_NAME=kubeshop

# Route 53 Hosted Zone ID (<HOSTED_ZONE_ID>)
HOSTED_ZONE_ID=Z00000000000000000000
